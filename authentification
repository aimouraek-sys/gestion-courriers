<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Authentification Firebase</title>
    
    <!-- Firebase SDK -->
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-auth-compat.js"></script>
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        
        .container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            padding: 40px;
            width: 100%;
            max-width: 400px;
        }
        
        h2 {
            color: #333;
            text-align: center;
            margin-bottom: 30px;
            font-size: 28px;
            font-weight: 600;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        label {
            display: block;
            margin-bottom: 8px;
            color: #555;
            font-weight: 500;
        }
        
        input {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            font-size: 16px;
            transition: all 0.3s;
        }
        
        input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }
        
        button {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            margin-top: 10px;
        }
        
        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
        }
        
        button:active {
            transform: translateY(0);
        }
        
        button.secondary {
            background: #f0f0f0;
            color: #555;
            margin-top: 10px;
        }
        
        button.secondary:hover {
            background: #e0e0e0;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
        
        .message {
            padding: 12px;
            border-radius: 10px;
            margin: 15px 0;
            text-align: center;
            font-weight: 500;
            display: none;
        }
        
        .message.error {
            background: #fee;
            color: #d63031;
            display: block;
        }
        
        .message.success {
            background: #e8f5e9;
            color: #27ae60;
            display: block;
        }
        
        .message.info {
            background: #e3f2fd;
            color: #1976d2;
            display: block;
        }
        
        .toggle-form {
            text-align: center;
            margin-top: 20px;
            color: #666;
        }
        
        .toggle-form a {
            color: #667eea;
            text-decoration: none;
            font-weight: 600;
            cursor: pointer;
        }
        
        .toggle-form a:hover {
            text-decoration: underline;
        }
        
        .password-requirements {
            font-size: 12px;
            color: #888;
            margin-top: 5px;
        }
        
        .logout-btn {
            background: #e74c3c !important;
        }
        
        .logout-btn:hover {
            background: #c0392b !important;
        }
    </style>
</head>
<body>
    <div class="container" id="app">
        <h2>🔐 Authentification</h2>
        
        <!-- Message d'erreur/succès -->
        <div id="message" class="message"></div>
        
        <!-- Formulaire de connexion -->
        <div id="loginForm">
            <div class="form-group">
                <label>📧 Email</label>
                <input type="email" id="loginEmail" placeholder="exemple@email.com" required>
            </div>
            
            <div class="form-group">
                <label>🔑 Mot de passe</label>
                <input type="password" id="loginPassword" placeholder="••••••••" required>
            </div>
            
            <button onclick="loginUser()">Se connecter</button>
            
            <div class="toggle-form">
                Pas encore de compte ? <a onclick="showRegister()">S'inscrire</a>
            </div>
        </div>
        
        <!-- Formulaire d'inscription -->
        <div id="registerForm" style="display: none;">
            <div class="form-group">
                <label>📧 Email</label>
                <input type="email" id="registerEmail" placeholder="exemple@email.com" required>
            </div>
            
            <div class="form-group">
                <label>🔑 Mot de passe</label>
                <input type="password" id="registerPassword" placeholder="••••••••" required>
                <div class="password-requirements">Minimum 6 caractères</div>
            </div>
            
            <button onclick="registerUser()">S'inscrire</button>
            
            <div class="toggle-form">
                Déjà un compte ? <a onclick="showLogin()">Se connecter</a>
            </div>
        </div>
        
        <!-- Contenu protégé (visible après connexion) -->
        <div id="protectedContent" style="display: none;">
            <h3 style="text-align: center; color: #27ae60; margin-bottom: 20px;">
                ✅ Connecté !
            </h3>
            <p style="text-align: center; color: #555; margin-bottom: 20px;">
                Vous avez accès au contenu protégé.
            </p>
            <button class="logout-btn" onclick="logoutUser()">Se déconnecter</button>
        </div>
    </div>

    <script>
        // VOTRE CONFIGURATION FIREBASE (à remplacer)
        const firebaseConfig = {
            apiKey: "VOTRE_API_KEY",
            authDomain: "VOTRE_PROJET.firebaseapp.com",
            projectId: "VOTRE_PROJET_ID",
            storageBucket: "VOTRE_PROJET.appspot.com",
            messagingSenderId: "VOTRE_SENDER_ID",
            appId: "VOTRE_APP_ID"
        };

        // Initialiser Firebase
        firebase.initializeApp(firebaseConfig);
        const auth = firebase.auth();

        // Références DOM
        const messageDiv = document.getElementById('message');
        const loginForm = document.getElementById('loginForm');
        const registerForm = document.getElementById('registerForm');
        const protectedContent = document.getElementById('protectedContent');

        // Fonctions d'affichage
        function showMessage(text, type = 'info') {
            messageDiv.textContent = text;
            messageDiv.className = `message ${type}`;
            messageDiv.style.display = 'block';
            
            // Cache automatiquement après 5 secondes
            clearTimeout(window.messageTimeout);
            window.messageTimeout = setTimeout(() => {
                messageDiv.style.display = 'none';
            }, 5000);
        }

        function showLogin() {
            loginForm.style.display = 'block';
            registerForm.style.display = 'none';
            messageDiv.style.display = 'none';
        }

        function showRegister() {
            loginForm.style.display = 'none';
            registerForm.style.display = 'block';
            messageDiv.style.display = 'none';
        }

        function showProtected() {
            loginForm.style.display = 'none';
            registerForm.style.display = 'none';
            protectedContent.style.display = 'block';
            messageDiv.style.display = 'none';
        }

        // Fonctions d'authentification
        function registerUser() {
            const email = document.getElementById('registerEmail').value;
            const password = document.getElementById('registerPassword').value;
            
            if (!email || !password) {
                showMessage('Veuillez remplir tous les champs', 'error');
                return;
            }
            
            if (password.length < 6) {
                showMessage('Le mot de passe doit faire au moins 6 caractères', 'error');
                return;
            }
            
            auth.createUserWithEmailAndPassword(email, password)
                .then((userCredential) => {
                    showMessage('Inscription réussie ! Bienvenue !', 'success');
                    setTimeout(() => showProtected(), 1000);
                })
                .catch((error) => {
                    showMessage(getErrorMessage(error.code), 'error');
                });
        }

        function loginUser() {
            const email = document.getElementById('loginEmail').value;
            const password = document.getElementById('loginPassword').value;
            
            if (!email || !password) {
                showMessage('Veuillez remplir tous les champs', 'error');
                return;
            }
            
            auth.signInWithEmailAndPassword(email, password)
                .then((userCredential) => {
                    showMessage('Connexion réussie !', 'success');
                    setTimeout(() => showProtected(), 1000);
                })
                .catch((error) => {
                    showMessage(getErrorMessage(error.code), 'error');
                });
        }

        function logoutUser() {
            auth.signOut()
                .then(() => {
                    showMessage('Déconnexion réussie', 'info');
                    loginForm.style.display = 'block';
                    protectedContent.style.display = 'none';
                    document.getElementById('loginEmail').value = '';
                    document.getElementById('loginPassword').value = '';
                })
                .catch((error) => {
                    showMessage('Erreur lors de la déconnexion', 'error');
                });
        }

        // Gestionnaire d'état d'authentification
        auth.onAuthStateChanged((user) => {
            if (user) {
                showProtected();
                showMessage(`Connecté en tant que ${user.email}`, 'success');
            } else {
                loginForm.style.display = 'block';
                registerForm.style.display = 'none';
                protectedContent.style.display = 'none';
            }
        });

        // Traduction des erreurs Firebase
        function getErrorMessage(errorCode) {
            const messages = {
                'auth/email-already-in-use': 'Cet email est déjà utilisé',
                'auth/invalid-email': 'Email invalide',
                'auth/weak-password': 'Le mot de passe est trop faible (minimum 6 caractères)',
                'auth/user-not-found': 'Aucun compte avec cet email',
                'auth/wrong-password': 'Mot de passe incorrect',
                'auth/too-many-requests': 'Trop de tentatives, veuillez réessayer plus tard',
                'auth/user-disabled': 'Ce compte a été désactivé'
            };
            return messages[errorCode] || 'Une erreur est survenue. Veuillez réessayer.';
        }

        // Permet de valider avec la touche Entrée
        document.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                if (loginForm.style.display !== 'none' && loginForm.style.display !== '') {
                    loginUser();
                } else if (registerForm.style.display !== 'none' && registerForm.style.display !== '') {
                    registerUser();
                }
            }
        });
    </script>
</body>
</html>
